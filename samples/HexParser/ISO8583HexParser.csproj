<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationHighDpiMode>SystemAware</ApplicationHighDpiMode>
    <AssemblyName>ISO8583HexParser</AssemblyName>
    <RootNamespace>ISO8583HexParser</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ISO8583Net\ISO8583Net.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Content Include="..\..\src\ISO8583Net\ISODialects\d8-iso8583.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <Link>d8-iso8583.json</Link>
    </Content>
  </ItemGroup>

</Project>
